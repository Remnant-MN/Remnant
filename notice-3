<!DOCTYPE html>
<html lang="ko">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Remnant 공지 사이트 | Remnant</title>

  <style>

    :root {
      --bg: #08080d;
      --panel: #11111a;
      --text: #f4f1ff;
      --muted: #a7a2b8;
      --accent: #a78bfa;
      --accent2: #6d28d9;
      --line: rgba(167,139,250,.22);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, "Noto Sans KR", sans-serif;
      background:
        radial-gradient(
          circle at top right,
          #21133c 0,
          var(--bg) 35%
        );

      color: var(--text);
      line-height: 1.8;
      min-height: 100vh;
    }

    header {
      background: rgba(8,8,13,.9);
      border-bottom: 1px solid var(--line);
    }

    nav {
      max-width: 1180px;
      margin: auto;
      padding: 18px 24px;

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-weight: 900;
      letter-spacing: .14em;
    }

    .logo span {
      color: var(--accent);
    }

    nav a {
      color: var(--muted);
      text-decoration: none;
    }

    nav a:hover {
      color: var(--text);
    }

    main {
      max-width: 900px;
      margin: auto;
      padding: 80px 24px;
    }

    .post {

      background: var(--panel);

      border: 1px solid var(--line);

      border-radius: 20px;

      overflow: hidden;

    }

    .post-header {

      padding: 30px;

      border-bottom: 1px solid var(--line);

    }

    .post-title {

      font-size: 2.2rem;

      margin-bottom: 10px;

    }

    .post-date {

      color: var(--accent);

      font-size: .9rem;

    }

    .post-content {

      padding: 35px;

      color: var(--muted);

      white-space: pre-line;

    }

    .post-content h2 {

      color: var(--text);

      margin-bottom: 20px;

    }

    .back-button {

      display: inline-block;

      margin-top: 30px;

      padding: 12px 20px;

      border: 1px solid var(--line);

      border-radius: 999px;

      color: var(--text);

      text-decoration: none;

      background: var(--panel);

    }

    .back-button:hover {

      background: var(--accent2);

    }

    footer {

      border-top: 1px solid var(--line);

      text-align: center;

      padding: 30px;

      color: var(--muted);

    }

    @media (max-width: 760px) {

      .post-title {

        font-size: 1.7rem;

      }

      .post-header,

      .post-content {

        padding: 24px;

      }

    }

  </style>

</head>


<body>


  <header>

    <nav>

      <div class="logo">

        POST <span>HUMAN</span>

      </div>


      <a href="notice.html">

        공지사항 목록

      </a>

    </nav>

  </header>


  <main>


    <article class="post">


      <div class="post-header">


        <h1 class="post-title">

         열람금지

        </h1>


        <div class="post-date">

         2026.07.25

        </div>


      </div>


      <div class="post-content">


        <h2>

         열람금지

        </h2>


        <p>
      미작성

        </p>


      </div>


    </article>


    <a

      href="notice.html"

      class="back-button"

    >

      ← 공지사항 목록으로 돌아가기

    </a>


  </main>


  <footer>

    © 2026 Remnant.

    All rights reserved.

  </footer>


</body>

</html>
